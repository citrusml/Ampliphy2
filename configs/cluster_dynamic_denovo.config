// ==============================================================================
// Nextflow Configuration for AmpliPhy on LSF Cluster (mafftsrv0-5, mafftweb)
// Mode: de novo (MAFFT 一から再構築) + MaxAlign なし (maxalign_after = false)
//       + Impoverished Tree 自動出力 (msa_imp/ & tree_imp/)
// ==============================================================================

params {
    // MAFFT 増幅モード: 'denovo' (集めてきた配列と元配列を一括して一からMSA再構築)
    mafft_amplify_mode = 'denovo'
    mafft_mode         = 'denovo'

    // MaxAlign なし
    maxalign_after     = false
    maxalign_options   = ''
}

executor {
    name            = 'lsf'
    queueSize       = 150
    pollInterval    = '10 sec'
    submitRateLimit = '5 sec'
}

conda {
    enabled = false
}

process {
    executor       = 'lsf'
    queue          = 'mafft'
    cache          = 'lenient'
    beforeScript   = '''
        set +u
        source ~/.bashrc 2>/dev/null || true
        export PATH="$HOME/Ampliphy2/ampliphy/bin:$HOME/ampliphy/bin:$HOME/.local/bin:$HOME/micromamba/bin:$PATH"
        if command -v micromamba &>/dev/null; then
            eval "$(micromamba shell hook --shell bash 2>/dev/null)" || true
            micromamba activate biotools 2>/dev/null || true
        elif command -v conda &>/dev/null; then
            eval "$(conda shell.bash hook 2>/dev/null)" || true
            conda activate biotools 2>/dev/null || true
        fi
        set -u
    '''

    withLabel: 'mmseqs' {
        cpus   = 8
        memory = 32.GB
        time   = 6.h
    }
    withLabel: 'tree' {
        cpus   = 4
        memory = 16.GB
        time   = 12.h
    }
    withLabel: 'short' {
        cpus   = 4
        memory = 8.GB
        time   = 2.h
    }
    withLabel: 'minimal' {
        cpus   = 1
        memory = 4.GB
        time   = 1.h
    }

    withName: 'iqtree_inference' {
        publishDir = [
            [
                path: { "${params.output_dir}/tree" },
                mode: 'copy',
                saveAs: { filename ->
                    if (filename.endsWith('.ori.nwk')) return filename
                    if (params.keep_unpruned_tree && filename.endsWith('.amp.unpruned.nwk')) return filename
                    return null
                }
            ],
            [
                path: { "${params.output_dir}/tree_imp" },
                mode: 'copy',
                saveAs: { filename ->
                    if (filename.endsWith('.imp.nwk')) return filename
                    return null
                }
            ]
        ]
    }
}

