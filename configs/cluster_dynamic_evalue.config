// ==============================================================================
// Nextflow Configuration for E-value x addfragments x MaxAlign Benchmark (LSF)
// ==============================================================================

params {
    database        = 'UniRef50'
    database_dir    = '/home/citrusml2004/mmseqs_db'
    tmp_dir         = '/tmp/ampliphy_evalue_bench'
    max_depth       = 5
    random_seed     = 42
    evalues         = '1e-100,1e-10,1e-3,1e-1,1e-0'
    variants        = 'maxa_on_keep_on,maxa_on_keep_off,maxa_off_keep_on,maxa_off_keep_off'
    lineage_file    = ''
    gs2_bin         = 'gs2'
    mad_script      = ''
    tcs_script      = ''
    maxalign_script = ''
}

executor {
    name            = 'lsf'
    queueSize       = 150
    pollInterval    = '10 sec'
    submitRateLimit = '5 sec'
}

conda {
    enabled = false
}

process {
    executor     = 'lsf'
    queue        = 'mafft'
    cache        = 'lenient'
    beforeScript = '''
        set +u
        source ~/.bashrc 2>/dev/null || true
        export PATH="$HOME/Ampliphy2/ampliphy/bin:$HOME/ampliphy/bin:$HOME/gs:$HOME/.local/bin:$HOME/micromamba/bin:$PATH"
        if command -v micromamba &>/dev/null; then
            eval "$(micromamba shell hook --shell bash 2>/dev/null)" || true
            micromamba activate biotools 2>/dev/null || true
        elif command -v conda &>/dev/null; then
            eval "$(conda shell.bash hook 2>/dev/null)" || true
            conda activate biotools 2>/dev/null || true
        fi
        export PYTHONPATH="$HOME/Ampliphy2:${PYTHONPATH:-}"
        set -u
    '''

    withLabel: 'mmseqs' {
        cpus   = 8
        memory = 32.GB
        time   = 6.h
    }
    withLabel: 'tree' {
        cpus   = 4
        memory = 16.GB
        time   = 12.h
    }
    withLabel: 'short' {
        cpus   = 4
        memory = 8.GB
        time   = 2.h
    }
    withLabel: 'minimal' {
        cpus   = 1
        memory = 4.GB
        time   = 1.h
    }
}
