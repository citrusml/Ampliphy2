// ==============================================================================
// Nextflow Configuration for AmpliPhy on LSF Cluster (mafftsrv0-5, mafftweb)
// ==============================================================================

executor {
    name            = 'lsf'
    queueSize       = 150
    pollInterval    = '10 sec'
    submitRateLimit = '5 sec'
}

conda {
    enabled = false
}

process {
    executor       = 'lsf'
    queue          = 'mafft'
    beforeScript   = '''
        set +u
        source ~/.bashrc 2>/dev/null || true
        export PATH="$HOME/Ampliphy2/ampliphy/bin:$HOME/ampliphy/bin:$HOME/.local/bin:$HOME/micromamba/bin:$PATH"
        if command -v micromamba &>/dev/null; then
            eval "$(micromamba shell hook --shell bash 2>/dev/null)" || true
            micromamba activate biotools 2>/dev/null || true
        elif command -v conda &>/dev/null; then
            eval "$(conda shell.bash hook 2>/dev/null)" || true
            conda activate biotools 2>/dev/null || true
        fi
        set -u
    '''

    withLabel: 'mmseqs' {
        cpus   = 8
        memory = 32.GB
        time   = 6.h
    }
    withLabel: 'tree' {
        cpus   = 4
        memory = 16.GB
        time   = 12.h
    }
    withLabel: 'short' {
        cpus   = 4
        memory = 8.GB
        time   = 2.h
    }
    withLabel: 'minimal' {
        cpus   = 1
        memory = 4.GB
        time   = 1.h
    }

    withName: 'iqtree_inference' {
        publishDir = [
            path: { "${params.output_dir}/tree" },
            mode: 'copy',
            saveAs: { filename ->
                if (filename.endsWith('.ori.nwk')) return filename
                if (params.keep_unpruned_tree && filename.endsWith('.amp.unpruned.nwk')) return filename
                return null
            }
        ]
    }
}

