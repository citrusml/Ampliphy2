// ==============================================================================
// Nextflow Configuration for SSS (linear / log) Pipeline on LSF Cluster
// ==============================================================================

params {
    model        = 'linear' // 'linear' or 'log'
    threads      = 4
    output_dir   = 'results_sss'
    lineage_file = ''
}

executor {
    name            = 'lsf'
    queueSize       = 150
    pollInterval    = '10 sec'
    submitRateLimit = '5 sec'
}

conda {
    enabled = false
}

process {
    executor     = 'lsf'
    queue        = 'mafft'
    cache        = 'lenient'
    beforeScript = '''
        set +u
        source ~/.bashrc 2>/dev/null || true
        export PATH="$HOME/Ampliphy2/ampliphy/bin:$HOME/ampliphy/bin:$HOME/.local/bin:$HOME/micromamba/bin:$PATH"
        if command -v micromamba &>/dev/null; then
            eval "$(micromamba shell hook --shell bash 2>/dev/null)" || true
            micromamba activate biotools 2>/dev/null || true
        elif command -v conda &>/dev/null; then
            eval "$(conda shell.bash hook 2>/dev/null)" || true
            conda activate biotools 2>/dev/null || true
        fi
        export PYTHONPATH="$HOME/Ampliphy2:${PYTHONPATH:-}"
        set -u
    '''

    withLabel: 'short' {
        cpus   = 4
        memory = 8.GB
        time   = 2.h
    }
    withLabel: 'minimal' {
        cpus   = 1
        memory = 4.GB
        time   = 1.h
    }
}
